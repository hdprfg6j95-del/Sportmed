  .btn:disabled { opacity: 0.4; cursor: not-allowed; }
  .btn-secondary { background: #e2e8f0; color: var(--text); }
  .btn-secondary:hover:not(:disabled) { background: #cbd5e1; }
  .btn-check { background: #0f172a; }
  .btn-check:hover:not(:disabled) { background: #334155; }
  .result-box { text-align: center; padding: 20px 10px; display: none; }
  .score-circle {
    width: 115px; height: 115px; border-radius: 50%; background: #eff6ff; border: 4px solid var(--primary);
