  bar.innerHTML = "";
  cats.forEach(c => {
    const btn = document.createElement("button");
    btn.className = "chip" + (c === activeCategory ? " active" : "");
    btn.textContent = c;
    btn.onclick = () => {
      activeCategory = c;
      initFilters();
      restartQuiz(false);
    };
    bar.appendChild(btn);
  });
}

function shuffle(arr) {
  const copy = [...arr];
  for (let i = copy.length - 1; i > 0; i--) {
    const j = Math.floor(Math.random() * (i + 1));
    [copy[i], copy[j]] = [copy[j], copy[i]];
  }
  return copy;
}

function restartQuiz(onlyWrong) {
  if (onlyWrong && wrongQuestions.length > 0) {
    currentPool = shuffle(wrongQuestions);
  } else {
    const filtered = activeCategory === "Alle" ? allQuestions : allQuestions.filter(q => q.cat === activeCategory);
    currentPool = shuffle(filtered);
  }
  currentIndex = 0;
  score = 0;
  wrongQuestions = [];
  document.getElementById("quizArea").style.display = "block";
  document.getElementById("resultBox").style.display = "none";
  renderQuestion();
}

function renderQuestion() {
  answered = false;
  selectedIndices.clear();
  const q = currentPool[currentIndex];

  document.getElementById("categoryLabel").textContent = q.cat;
  const typeTag = document.getElementById("typeTag");
  if (q.multi) {
    typeTag.textContent = "☑ Mehrfachauswahl (mehrere richtig)";
    typeTag.className = "type-tag multi";
  } else {
    typeTag.textContent = "◉ Einzelauswahl (1 richtig)";
    typeTag.className = "type-tag";
  }

  document.getElementById("questionText").textContent = q.q;
  document.getElementById("counterText").textContent = `Frage ${currentIndex + 1} von ${currentPool.length}`;
  document.getElementById("scoreBadge").textContent = `Punkte: ${score} / ${currentIndex}`;
  document.getElementById("progressBar").style.width = `${(currentIndex / currentPool.length) * 100}%`;

  const fb = document.getElementById("feedbackBox");
  fb.className = "feedback";
  fb.textContent = "";

  const checkBtn = document.getElementById("checkBtn");
  const nextBtn = document.getElementById("nextBtn");

  if (q.multi) {
    checkBtn.style.display = "inline-block";
    checkBtn.disabled = true;
    nextBtn.disabled = true;
  } else {
    checkBtn.style.display = "none";
    nextBtn.disabled = true;
  }
  nextBtn.textContent = currentIndex === currentPool.length - 1 ? "Ergebnis anzeigen" : "Weiter →";

  const container = document.getElementById("optionsContainer");
  container.innerHTML = "";
  const letters = ["A", "B", "C", "D"];

  q.options.forEach((opt, idx) => {
    const btn = document.createElement("button");
    btn.className = "option-btn";
    const symbol = q.multi ? "☐" : letters[idx];
    btn.innerHTML = `<span class="marker">${symbol}</span><span>${opt}</span>`;
    btn.onclick = () => handleOptionClick(idx, btn);
    container.appendChild(btn);
  });
}

function handleOptionClick(idx, btn) {
  if (answered) return;
  const q = currentPool[currentIndex];

  if (!q.multi) {
    selectedIndices.add(idx);
    evaluateAnswer();
  } else {
    if (selectedIndices.has(idx)) {
      selectedIndices.delete(idx);
      btn.classList.remove("selected");
      btn.querySelector(".marker").textContent = "☐";
    } else {
      selectedIndices.add(idx);
      btn.classList.add("selected");
      btn.querySelector(".marker").textContent = "☑";
    }
    document.getElementById("checkBtn").disabled = selectedIndices.size === 0;
  }
}

function checkMultiAnswer() {
  if (answered || selectedIndices.size === 0) return;
  evaluateAnswer();
}

function evaluateAnswer() {
  answered = true;
  const q = currentPool[currentIndex];
  const buttons = document.querySelectorAll(".option-btn");
  buttons.forEach(b => b.disabled = true);
  document.getElementById("checkBtn").disabled = true;

  const correctSet = new Set(q.correct);
  let isExactMatch = selectedIndices.size === correctSet.size && [...selectedIndices].every(i => correctSet.has(i));

  buttons.forEach((btn, idx) => {
    btn.classList.remove("selected");
    const isCorrectOpt = correctSet.has(idx);
    const isSelectedOpt = selectedIndices.has(idx);

    if (isCorrectOpt) {
      btn.classList.add("correct");
      if (q.multi) btn.querySelector(".marker").textContent = "✓";
    } else if (isSelectedOpt && !isCorrectOpt) {
      btn.classList.add("wrong");
      if (q.multi) btn.querySelector(".marker").textContent = "✕";
    }
  });

  if (isExactMatch) {
    score++;
  } else {
    wrongQuestions.push(q);
  }

  document.getElementById("scoreBadge").textContent = `Punkte: ${score} / ${currentIndex + 1}`;
  const fb = document.getElementById("feedbackBox");
  const statusText = isExactMatch
    ? "✅ Vollständig richtig!"
    : `❌ Nicht ganz (${q.correct.length} richtige Antwort${q.correct.length > 1 ? "en" : ""} waren gesucht).`;
  fb.innerHTML = `<strong>${statusText}</strong> ${q.exp}`;
  fb.classList.add("show");
  document.getElementById("nextBtn").disabled = false;
}

function nextQuestion() {
  if (currentIndex < currentPool.length - 1) {
    currentIndex++;
    renderQuestion();
  } else {
    showResults();
  }
}

function showResults() {
  document.getElementById("progressBar").style.width = "100%";
  document.getElementById("quizArea").style.display = "none";
  document.getElementById("resultBox").style.display = "block";

  const pct = Math.round((score / currentPool.length) * 100);
  document.getElementById("finalPercent").textContent = `${pct}%`;
  document.getElementById("finalFraction").textContent = `${score} von ${currentPool.length} richtig`;

  const retryWrongBtn = document.getElementById("retryWrongBtn");
  if (wrongQuestions.length > 0) {
    retryWrongBtn.style.display = "inline-block";
    retryWrongBtn.textContent = `Falsche Fragen wiederholen (${wrongQuestions.length})`;
  } else {
    retryWrongBtn.style.display = "none";
  }

  let title = "Super gemacht!";
  let text = "Du beherrschst alle Inhalte der Vorlesung „Einführung Knochen“ inklusive der Mehrfachauswahl-Fragen.";
  if (pct < 50) {
    title = "Guter Start!";
    text = "Nutze die Themen-Filter oben oder wiederhole gezielt die falschen Fragen.";
  } else if (pct < 85) {
    title = "Schon sehr stark!";
    text = "Die wichtigsten Konzepte sitzen – gehe jetzt noch die restlichen Detailfragen durch.";
  }
  document.getElementById("resultTitle").textContent = title;
  document.getElementById("resultText").textContent = text;
}

initFilters();
restartQuiz(false);
</script>
</body>
</html>
