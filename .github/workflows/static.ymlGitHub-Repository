  .score-num { font-size: 1.65rem; font-weight: 800; color: var(--primary); }
  .score-sub { font-size: 0.8rem; color: var(--muted); }
  .filter-bar { display: flex; gap: 6px; margin-bottom: 16px; flex-wrap: wrap; }
  .chip {
